<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<!-- Same feed key as ObsidianPay/tessera, so the credentials stored in your user-level NuGet.Config apply. -->
		<add key="ObsidianPayCustomFeed" value="https://nuget.pkg.github.com/ObsidianPay/index.json" protocolVersion="3" />
	</packageSources>
</configuration>
