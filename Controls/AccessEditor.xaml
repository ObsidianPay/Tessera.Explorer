<UserControl x:Class="Tessera.Explorer.Controls.AccessEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Access rights (key number per right)" Style="{StaticResource FieldLabel}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="READ" Style="{StaticResource Eyebrow}" Margin="0,0,0,3"/>
      <TextBlock Grid.Column="2" Text="WRITE" Style="{StaticResource Eyebrow}" Margin="0,0,0,3"/>
      <TextBlock Grid.Column="4" Text="READ+WRITE" Style="{StaticResource Eyebrow}" Margin="0,0,0,3"/>
      <TextBlock Grid.Column="6" Text="CHANGE" Style="{StaticResource Eyebrow}" Margin="0,0,0,3"/>
      <ComboBox x:Name="ReadBox" Grid.Row="1" SelectionChanged="Changed"/>
      <ComboBox x:Name="WriteBox" Grid.Row="1" Grid.Column="2" SelectionChanged="Changed"/>
      <ComboBox x:Name="RwBox" Grid.Row="1" Grid.Column="4" SelectionChanged="Changed"/>
      <ComboBox x:Name="ChangeBox" Grid.Row="1" Grid.Column="6" SelectionChanged="Changed"/>
    </Grid>
    <TextBlock x:Name="Packed" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,4,0,0"/>
  </StackPanel>
</UserControl>
