<UserControl x:Class="Tessera.Explorer.Controls.KeyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tessera.Explorer.Controls"
             xmlns:nx="clr-namespace:Tessera.Nxpsc;assembly=Tessera.Nxpsc">
  <StackPanel>
    <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabel}"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="84"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <c:EnumBox x:Name="TypeBox" EnumType="{x:Type nx:NxpscKeyType}" SelectionChanged="TypeBox_Changed" ToolTip="Key type"/>
      <TextBox x:Name="VersionBox" Grid.Column="2" Style="{StaticResource MonoTextBox}" Text="00" ToolTip="Key version (hex byte). AES: loaded with the key. DES: carried in the parity bits."/>
      <StackPanel Grid.Column="4" Orientation="Horizontal">
        <Button Content="Zero" Click="Zero_Click" Padding="10,0" ToolTip="All-zero key of this type (factory)"/>
        <Button Content="Random" Click="Random_Click" Padding="10,0" Margin="6,0,0,0" ToolTip="Fresh random key bytes"/>
        <TextBlock x:Name="LengthText" Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <TextBox x:Name="KeyBox" Style="{StaticResource MonoTextBox}" Margin="0,6,0,0" TextChanged="KeyBox_Changed"
             ToolTip="Key bytes in hex. Never logged by the explorer."/>
  </StackPanel>
</UserControl>
