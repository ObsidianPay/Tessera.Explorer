<UserControl x:Class="Tessera.Explorer.Pages.ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Tessera.Explorer.Controls"
             xmlns:nx="clr-namespace:Tessera.Nxpsc;assembly=Tessera.Nxpsc">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <c:OpCard Title="Open a session" Description="PC/SC reader or libnxpsc's mock card. The session is opened with NxpscCard.Open and the card is identified straight away.">
          <StackPanel>
            <c:Field Label="Source">
              <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Rescan PC/SC readers"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/></Button>
                <ComboBox x:Name="SourceBox" SelectionChanged="Source_Changed"/>
              </DockPanel>
            </c:Field>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <c:Field Label="Command set" Margin="0,0,0,10">
                <c:EnumBox x:Name="CmdSetBox" EnumType="{x:Type nx:NxpscCmdSet}"/>
              </c:Field>
              <c:Field Grid.Column="2" Label="Wait for card (s)" Margin="0,0,0,10">
                <TextBox x:Name="TimeoutBox" Text="30" Style="{StaticResource MonoTextBox}"/>
              </c:Field>
            </Grid>
            <TextBlock x:Name="SourceHint" Style="{StaticResource MutedText}" Margin="0,0,0,2"/>
          </StackPanel>
          <c:OpCard.Actions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="OpenButton" Content="Open session" Style="{StaticResource PrimaryButton}" Click="Open_Click" MinWidth="120"/>
              <Button x:Name="CancelWaitButton" Content="Stop waiting" Margin="8,0,0,0" Click="CancelWait_Click" Visibility="Collapsed"/>
              <Button x:Name="CloseButton" Content="Close session" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
          </c:OpCard.Actions>
        </c:OpCard>

        <c:OpCard Grid.Column="2" Title="Session state" Description="What libnxpsc reports about the open session. Refreshed after every call.">
          <TextBlock x:Name="StateText" Style="{StaticResource Mono}" FontSize="12" LineHeight="20" TextWrapping="Wrap"/>
        </c:OpCard>
      </Grid>

      <c:OpCard Title="Identification" Description="Read-only queries that need no authentication (GetCardUID and a few others may).">
        <WrapPanel>
          <Button Content="GetVersion" Click="GetVersion_Click" Margin="0,0,8,8"/>
          <Button Content="Identify" Click="Identify_Click" Margin="0,0,8,8"/>
          <Button Content="CardType (cached)" Click="CardType_Click" Margin="0,0,8,8"/>
          <Button Content="GetCardUID" Click="Uid_Click" Margin="0,0,8,8"/>
          <Button Content="GetFreeMemory" Click="Free_Click" Margin="0,0,8,8"/>
          <Button Content="GetSignature" Click="Sig_Click" Margin="0,0,8,8"/>
        </WrapPanel>
      </c:OpCard>

      <c:OpCard Title="Session settings" Description="Property writes on the open card.">
        <WrapPanel>
          <c:Field Label="CmdSet" Width="190"><c:EnumBox x:Name="LiveCmdSet" EnumType="{x:Type nx:NxpscCmdSet}"/></c:Field>
          <c:Field Label="Default comm mode" Width="190"><c:EnumBox x:Name="LiveComm" EnumType="{x:Type nx:NxpscCommMode}"/></c:Field>
          <c:Field Label="ISO chaining"><CheckBox x:Name="IsoChain" Content="0xAD / 0x8D / 0xAB / 0x8B / 0xBA" Margin="0,6,0,0"/></c:Field>
        </WrapPanel>
        <c:OpCard.Actions>
          <StackPanel Orientation="Horizontal">
            <Button Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="ResetChannel" Click="ResetChannel_Click" Margin="8,0,0,0" ToolTip="Forget the secure channel on the host side"/>
          </StackPanel>
        </c:OpCard.Actions>
      </c:OpCard>

      <c:OpCard Title="Library" Description="libnxpsc functions that need no card.">
        <c:OpCard.Actions>
          <StackPanel Orientation="Horizontal">
            <Button Content="Version" Click="LibVersion_Click"/>
            <Button Content="Self test" Click="SelfTest_Click" Margin="8,0,0,0"/>
          </StackPanel>
        </c:OpCard.Actions>
      </c:OpCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
