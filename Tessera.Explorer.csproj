<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>Tessera.Explorer</RootNamespace>
    <AssemblyName>Tessera.Explorer</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Tessera Explorer</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tessera.Nxpsc" Version="0.5.1-ci.8" />
    <PackageReference Include="Tessera.Nxpsc.MockCard" Version="0.5.1-ci.8" />
  </ItemGroup>


</Project>
